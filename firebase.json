{
  "hosting": {
    "site": "auric-ai",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "qa/**",
      "downloads/**",
      "**/*.exe",
      "**/*.apk",
      "**/*.dll",
      "**/*.zip",
      "README.md",
      ".github/**"
    ],
    "headers": [
      {
        "source": "/release.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  }
}
